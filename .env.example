# AI Content OS Environment Configuration Template
APP_NAME="AI Content OS"
APP_ENV="development"
DEBUG=true

# Server Configuration
HOST="127.0.0.1"
PORT=8000

# Storage & Database Paths
USER_DATA_DIR="./user_data"
DB_NAME="ai_content_os.db"

# Browser Automation Controls
HEADLESS=false
BROWSER_SLOW_MO=50
NAVIGATION_TIMEOUT=60000

# Target Platform URLs
GEMINI_WEB_URL="https://gemini.google.com/app"
LINKEDIN_WEB_URL="https://www.linkedin.com/feed/"
X_TWITTER_WEB_URL="https://x.com/home"
